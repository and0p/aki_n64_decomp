{
  "version": 3,
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native (Ninja, Release with debug info)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build/native",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "debug",
      "displayName": "Native (Ninja, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "native", "configurePreset": "native" },
    { "name": "debug", "configurePreset": "debug" }
  ],
  "testPresets": [
    { "name": "native", "configurePreset": "native", "output": { "outputOnFailure": true } }
  ]
}
